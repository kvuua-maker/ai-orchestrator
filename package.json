{
  "name": "ai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Universal RPA Agent SaaS: chat in, plan and execution out — browser, code, shell, CRM, social, scraping.",
  "license": "UNLICENSED",
  "engines": { "node": ">=22.0.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @aio/api",
    "dev:web": "npm run dev --workspace @aio/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "npm run db:migrate --workspace @aio/api"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2"
  }
}
