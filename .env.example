# ---------------------------------------------------------------------------
# AI-Orchestrator — environment surface
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=debug

# --- database ---
DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379

# --- object storage (artifacts: screenshots, traces, files) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=orchestrator-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- auth ---
BETTER_AUTH_SECRET=change-me-32-bytes-min
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- encryption (envelope encryption for tenant secrets) ---
# 32-byte base64 master key; in prod this is a KMS key reference instead
MASTER_ENCRYPTION_KEY=
KMS_PROVIDER=local            # local | aws-kms | gcp-kms

# --- model providers ---
# Preferred: route everything through a self-hosted LiteLLM gateway so cost,
# fallbacks and per-tenant keys live in one place.
LLM_GATEWAY_URL=http://localhost:4001
LLM_GATEWAY_MASTER_KEY=

# ---- $0 DEVELOPMENT MODE (default until first revenue) ----
# See ARCHITECTURE.md §11.3. All of these have permanent free tiers, no card.
# Role mapping: S=planner/critic, W=workhorse, L=extraction, V=vision.
LLM_S_PROVIDER=github-models        # GPT-4o free, 15 RPM / 150-1000 RPD
GITHUB_MODELS_TOKEN=
LLM_W_PROVIDER=groq                 # Llama 3.3 70B, 30 RPM / 1000 RPD
GROQ_API_KEY=
LLM_L_PROVIDER=google               # Gemini Flash free, 5-15 RPM
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_LONG_CONTEXT_PROVIDER=google    # 1M context on free tier
LLM_FALLBACK_PROVIDER=openrouter    # 20 RPM / 50 RPD
OPENROUTER_API_KEY=

# local model for smoke tests and offline CI (zero cost, no rate limit)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# embeddings run locally on CPU (fastembed) — no API cost
EMBEDDINGS_PROVIDER=local           # local | openai | voyage
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# paid providers — leave empty until a trigger in §11.8 fires
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# record/replay LLM gateway: "replay" in CI (free), "record" to capture fixtures
LLM_GATEWAY_MODE=record             # live | record | replay

# --- browser / anti-bot ---
BROWSER_RUNNER_URL=http://localhost:3001
BROWSER_RUNNER_TOKEN=
BROWSER_DEFAULT_ENGINE=chromium     # chromium | camoufox | http
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENT_PER_TENANT=2

# proxy pool (per-tenant BYO proxies override these)
# $0 default: server IP + Webshare free (10 DC proxies, 1 GB/mo) + phone via SSH tunnel
PROXY_PROVIDER=free                 # free | brightdata | oxylabs | decodo | iproyal | none
PROXY_GATEWAY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_COUNTRY=us
# phone/home residential IP tunneled in for landmark validation (see §11.5)
PROXY_SOCKS_FALLBACK=socks5://localhost:1080

# captcha solving (paid, metered, opt-in per tenant) — DEFAULT IS HUMAN TAKEOVER = $0
CAPTCHA_PROVIDER=none               # none (takeover) | capsolver | 2captcha
CAPTCHA_API_KEY=
CAPTCHA_MONTHLY_BUDGET_USD=0

# --- sandbox / code execution ---
SANDBOX_DRIVER=docker              # docker | gvisor | firecracker | e2b
SANDBOX_IMAGE=orchestrator/sandbox-base:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_NETWORK=none               # none | proxy-egress
SANDBOX_MAX_CPU=2
SANDBOX_MAX_MEMORY_MB=2048

# --- ssh / server access for the "sysadmin" tool ---
SSH_BASTION_HOST=
SSH_KEY_ENCRYPTION=tenant-dek
SSH_COMMAND_TIMEOUT_SECONDS=120
SSH_ALLOW_DESTRUCTIVE=false

# --- billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_METER_TOKENS=
PADDLE_API_KEY=                    # optional merchant-of-record alternative

# --- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3030
SENTRY_DSN=

# --- feature flags ---
FEATURE_STEALTH_TIER=2             # max anti-bot tier enabled
FEATURE_HUMAN_TAKEOVER=true
FEATURE_TELEGRAM_BOT=
FEATURE_EMAIL_INBOX=

# ---------------------------------------------------------------------------
# БІЗНЕС-МОДУЛІ (Частина II). Усе нижче має $0-шлях — див. ARCHITECTURE.md §14–17
# ---------------------------------------------------------------------------

# --- CRM (§14) ---
CRM_DEFAULT_ADAPTER=keycrm        # keycrm | bitrix24 | lpcrm | salesdrive | mock
CRM_KEYCRM_API_KEY=               # Authorization: Bearer <key>, 20 req/min
CRM_BITRIX24_WEBHOOK_URL=         # https://<portal>.bitrix24.ua/rest/<user>/<token>/
CRM_LPCRM_API_KEY=                # X-API-KEY header
CRM_SALESDRIVE_API_KEY=
CRM_RATE_LIMIT_PER_MINUTE=15      # тримаємо нижче за ліміт провайдера
CRM_DRY_RUN=true                  # обов'язково true до першого підтвердження клієнтом

# --- документи (§14.8) ---
DOCX_RENDERER=libreoffice         # libreoffice | typst
LIBREOFFICE_URL=http://localhost:8090   # окремий пул контейнерів, не головний процес

# --- соцмережі (§15) ---
TELEGRAM_BOT_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=                      # Instagram Graph — після app review
META_APP_SECRET=
TIKTOK_CLIENT_KEY=                # після audit застосунку
TIKTOK_CLIENT_SECRET=
SOCIAL_REQUIRE_APPROVAL_POSTS=20  # перші N постів на акаунт — тільки з підтвердженням
SOCIAL_MAX_POSTS_PER_DAY=3        # не перевищувати історичний темп акаунта
SOCIAL_ONBOARDING_MODE=takeover   # takeover (людина вводить пароль) | oauth

# --- парсинг (§16) ---
SCRAPE_EXTRACT_ORDER=jsonld,state,dom,llm   # LLM — лише як fallback, не за замовчуванням
SCRAPE_MAX_RPS_PER_DOMAIN=1
SCRAPE_PRICE_HISTORY_RETENTION_DAYS=730
SCRAPE_CONFIRM_DISAPPEAR_AFTER=2  # скільки 404 поспіль, щоб вважати товар зниклим

# --- Account Vault (§17) ---
VAULT_MASTER_KEY=                 # 32 байти base64; НЕ в git, бекапити окремо
VAULT_KEY_PROVIDER=local          # local | aws-kms | gcp-kms
VAULT_CANARY_ENABLED=true         # honeytoken: спрацювання = інцидент SEV1
VAULT_GRANT_TTL_SECONDS=7200      # максимум 2 години на run
VAULT_AUDIT_RETENTION_DAYS=365

# --- Affiliate & Monetization (§18) ---
AFFILIATE_ENABLED=false           # увімкнено лише для Free-тарифу або BYO-режиму
AFFILIATE_MODE=off                # platform | byo | off
AFFILIATE_DISCLOSURE=banner       # banner | inline | both
AFFILIATE_MAX_LINKS_PER_ANSWER=10
AFFILIATE_EXCLUDED_DOMAINS=       # ніколи не переписувати (власні домени клієнта тощо)
AFFILIATE_POSTBACK_BASE_URL=https://api.example.com/v1/hooks/affiliate
AFFILIATE_FX_PROVIDER=ecb        # ecb | exchangerate.host
# ключі мереж НЕ тут — вони у vault, тут лише посилання
AFFILIATE_NETWORKS=admitad,salesdoubler,syndicate

# --- Documents: OCR, генерація, папки (§13) ---
OCR_ENGINE=tesseract              # tesseract | vlm | auto (vlm якщо conf < 0.7)
OCR_LANGS=ukr+eng
OCR_MAX_CONCURRENT=2
OCR_VLM_ENABLED=false             # вмикати лише коли є квота/ключ
DOCS_MAX_FILE_MB=25
DOCS_MAX_BATCH_MB=200
DOCS_CONFIDENCE_GATE=0.85         # нижче — обов'язкове підтвердження людиною
DOCS_RENDERER_POOL=http://localhost:8090   # LibreOffice/Typst, окремий пул
DOCS_TEMPLATE_DIR=./packages/modules/documents/templates
VFS_ENABLED=true
VFS_DEFAULT_ROOT=/{year}/{month}/{kind}
PDF_TEXT_LAYER_FIRST=true         # не запускати OCR, якщо є текстовий шар
DOCS_MASK_PAN=true                # маскувати номер картки на вході

# --- UX / продуктова готовність (§28–30) ---
UI_DEFAULT_LOCALE=uk
ONBOARDING_DEMO_MODE=true         # перший результат до підключення акаунтів
DRY_RUN_DEFAULT=false             # тренувальний режим за замовчуванням для нових тенантів
UNDO_WINDOW_SECONDS=60            # затримка перед відправкою листів
PROACTIVE_SUGGESTIONS=true
SUGGESTION_MAX_PER_WEEK=1
SUGGESTION_MIN_OCCURRENCES=3
SUGGESTION_DISABLED_CATEGORIES=finance,medical,legal
NOTIFY_TELEGRAM_ON_DONE=true
TELEGRAM_MAX_UPLOAD_MB=20         # ліміт Bot API для файлів
