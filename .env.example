# ---------------------------------------------------------------------------
# AI-Orchestrator — environment surface
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=debug

# --- database ---
DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379

# --- object storage (artifacts: screenshots, traces, files) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=orchestrator-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- auth ---
BETTER_AUTH_SECRET=change-me-32-bytes-min
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- encryption (envelope encryption for tenant secrets) ---
# 32-byte base64 master key; in prod this is a KMS key reference instead
MASTER_ENCRYPTION_KEY=
KMS_PROVIDER=local            # local | aws-kms | gcp-kms

# --- model providers ---
# Preferred: route everything through a self-hosted LiteLLM gateway so cost,
# fallbacks and per-tenant keys live in one place.
LLM_GATEWAY_URL=http://localhost:4001
LLM_GATEWAY_MASTER_KEY=

# direct provider keys (used when the gateway is disabled)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# --- browser / anti-bot ---
BROWSER_RUNNER_URL=http://localhost:3001
BROWSER_RUNNER_TOKEN=
BROWSER_DEFAULT_ENGINE=chromium     # chromium | camoufox | http
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENT_PER_TENANT=2

# proxy pool (per-tenant BYO proxies override these)
PROXY_PROVIDER=                    # brightdata | oxylabs | decodo | iproyal | none
PROXY_GATEWAY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_COUNTRY=us

# captcha solving (paid, metered, opt-in per tenant)
CAPTCHA_PROVIDER=                  # capsolver | 2captcha | none
CAPTCHA_API_KEY=
CAPTCHA_MONTHLY_BUDGET_USD=20

# --- sandbox / code execution ---
SANDBOX_DRIVER=docker              # docker | gvisor | firecracker | e2b
SANDBOX_IMAGE=orchestrator/sandbox-base:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_NETWORK=none               # none | proxy-egress
SANDBOX_MAX_CPU=2
SANDBOX_MAX_MEMORY_MB=2048

# --- ssh / server access for the "sysadmin" tool ---
SSH_BASTION_HOST=
SSH_KEY_ENCRYPTION=tenant-dek
SSH_COMMAND_TIMEOUT_SECONDS=120
SSH_ALLOW_DESTRUCTIVE=false

# --- billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_METER_TOKENS=
PADDLE_API_KEY=                    # optional merchant-of-record alternative

# --- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3030
SENTRY_DSN=

# --- feature flags ---
FEATURE_STEALTH_TIER=2             # max anti-bot tier enabled
FEATURE_HUMAN_TAKEOVER=true
FEATURE_TELEGRAM_BOT=
FEATURE_EMAIL_INBOX=
